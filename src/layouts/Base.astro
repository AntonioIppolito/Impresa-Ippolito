---
import '../styles/global.css';
import { site, services, ORG_ID, PERSON_ID } from '../data/site';
import { google } from '../data/recensioni';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noMobileCta?: boolean;
  /** JSON-LD aggiuntivi della pagina (FAQPage, Service, BreadcrumbList…) */
  schema?: Record<string, unknown>[];
  /** briciole di pane: [{name, path}] (la Home viene aggiunta in automatico) */
  breadcrumb?: { name: string; path: string }[];
  /** pagine da non indicizzare (404) */
  noindex?: boolean;
}
const { title, description, image = '/og-default.jpg', noMobileCta = false, schema = [], breadcrumb, noindex = false } = Astro.props;
const siteUrl = Astro.site!.href.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// Entità impresa: stessa @id su tutte le pagine, così Google e le IA la riconoscono come una sola
const org = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': ORG_ID,
  name: site.officialName,
  legalName: site.legal.ragioneSociale,
  alternateName: site.alternateNames,
  description:
    'Impresa edile di ristrutturazioni chiavi in mano con sede a Novate Milanese, attiva dal 2001 in provincia di Milano e in Monza Brianza. Il titolare, il geom. Antonio Ippolito, ha oltre 30 anni di esperienza, segue i lavori di persona in cantiere e cura pratiche edilizie (CILA, SCIA) e direzione dei lavori.',
  url: `${siteUrl}/`,
  logo: `${siteUrl}/logo.png`,
  image: ogImage,
  telephone: site.phone.href.replace('tel:', ''),
  email: site.email,
  foundingDate: site.foundingYear,
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: site.hours.weekdays.opens, closes: site.hours.weekdays.closes },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: site.hours.saturday.opens, closes: site.hours.saturday.closes },
  ],
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressRegion: site.address.province,
    addressCountry: 'IT',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.address.geo.lat, longitude: site.address.geo.lng },
  areaServed: [
    ...site.cities.map((c) => ({ '@type': 'City', name: c })),
    { '@type': 'AdministrativeArea', name: 'Città metropolitana di Milano' },
    { '@type': 'AdministrativeArea', name: 'Provincia di Monza e della Brianza' },
  ],
  founder: { '@type': 'Person', '@id': PERSON_ID, name: 'Antonio Ippolito', jobTitle: 'Geometra, titolare' },
  employee: { '@id': PERSON_ID },
  vatID: `IT${site.legal.piva}`,
  knowsAbout: services.map((s) => s.t),
  sameAs: [site.facebook, site.instagram, site.paginegialle, google.url],
  hasMap: google.url,
};

const crumbs = breadcrumb?.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumb].map((b, i) => ({
        '@type': 'ListItem', position: i + 1, name: b.name, item: `${siteUrl}${b.path}`,
      })),
    }]
  : [];
const jsonld = [org, ...crumbs, ...schema];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2d76b6" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:bg-[var(--color-text)] focus:px-4 focus:py-2 focus:text-white">Salta al contenuto</a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!noMobileCta && <MobileCTA />}
  </body>
</html>

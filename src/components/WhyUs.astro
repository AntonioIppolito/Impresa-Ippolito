---
import { guarantees, transparency } from '../data/site';
// usata nella sezione scura "Perché sceglierci"
const tinted = (i: number) => (Math.floor(i / 2) + (i % 2)) % 2 === 0;
---
<!-- Preventivi trasparenti: banner in evidenza -->
<div class="mb-4 flex flex-col gap-4 border-l-4 border-[var(--color-accent)] bg-white p-6 sm:flex-row sm:items-center md:p-7">
  <div class="sm:flex-1">
    <span class="font-[family-name:var(--font-mono)] text-xs font-bold uppercase tracking-[0.2em] text-[var(--color-accent)]">In evidenza</span>
    <h3 class="mt-2 text-2xl font-black tracking-tight text-[var(--color-text)] md:text-3xl">{transparency.t}</h3>
  </div>
  <p class="text-base text-[var(--color-muted)] sm:max-w-md">{transparency.d}</p>
</div>

<div class="grid grid-cols-1 border-l border-t border-white/15 sm:grid-cols-2">
  {guarantees.map((g, i) => (
    <div
      class:list={[
        'card-anim group relative overflow-hidden border-b border-r border-white/15 p-6 [--card-bar:#fff] [--card-shadow:#fff] hover:bg-[var(--color-accent)] md:p-7',
        tinted(i) ? 'bg-white/[0.05]' : 'bg-transparent',
      ]}
    >
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -right-2 -top-4 font-[family-name:var(--font-display)] text-[5.5rem] font-black leading-none text-[var(--color-accent)]/45 transition-colors duration-300 group-hover:text-white/25"
      >{String(i + 1).padStart(2, '0')}</span>
      <div class="relative">
        <span class="font-[family-name:var(--font-mono)] text-xs font-bold uppercase tracking-[0.2em] text-[var(--color-accent)] transition-colors group-hover:text-white">Garanzia {String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-3 text-2xl font-black leading-[1.02] tracking-tight text-white transition-colors">{g.t}</h3>
        <p class="mt-2 text-[0.95rem] leading-snug text-white/60 transition-colors group-hover:text-white/90">{g.d}</p>
      </div>
    </div>
  ))}
</div>

---
import { Image } from 'astro:assets';
import { site, nav } from '../data/site';
import logo from '../assets/logo-trim.png';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const isActiveItem = (n: (typeof nav)[number]) => (n.children ? n.children.some((c) => isActive(c.href)) : isActive(n.href));
---
<!-- barra servizio: info utili e contatti diretti (scorre via, non è sticky) -->
<div class="hidden bg-[var(--color-text)] text-white md:block">
  <div class="u-container flex h-10 items-center justify-between gap-6 text-[0.8rem]">
    <p class="flex items-center gap-2 font-semibold">
      <svg class="h-4 w-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
      Sopralluogo e preventivo gratuiti
    </p>
    <ul class="flex items-center gap-6 text-white/80">
      <li class="hidden items-center gap-2 xl:flex">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        {site.hours.label}
      </li>
      <li class="hidden lg:block">
        <a href={`mailto:${site.email}`} class="flex items-center gap-2 transition-colors hover:text-white">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" /><path d="M3 6l9 7 9-7" /></svg>
          {site.email}
        </a>
      </li>
      <li>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="flex items-center gap-2 transition-colors hover:text-white">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z" /></svg>
          WhatsApp
        </a>
      </li>
      <li>
        <a href={site.phone.href} class="flex items-center gap-2 font-semibold text-white transition-colors hover:text-[var(--color-accent)]">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
          {site.phone.display}
        </a>
      </li>
    </ul>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-surface)_96%,transparent)] backdrop-blur">
  <div class="u-container flex h-[72px] items-center justify-between gap-4 md:h-20">
    <a href="/" class="flex shrink-0 items-center" aria-label="Impresa Ippolito, home">
      <Image src={logo} alt="Impresa Ippolito, ristrutturazioni chiavi in mano" widths={[200, 300, 340]} sizes="200px" class="h-10 w-auto md:h-12" loading="eager" />
    </a>

    <nav class="hidden h-full items-center gap-0.5 xl:flex" aria-label="Principale">
      {nav.map((n) =>
        n.children ? (
          <div class="nav-drop relative flex h-full items-center" data-drop>
            <button
              type="button"
              class:list={['nav-link flex items-center gap-1.5', isActiveItem(n) && 'is-active']}
              aria-expanded="false"
              aria-controls="drop-faq"
            >
              {n.label}
              <svg class="nav-drop__caret h-3 w-3" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
            </button>
            <div id="drop-faq" class="nav-drop__panel absolute left-0 top-full w-[22rem] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-[0_18px_40px_-18px_rgb(0_0_0/0.35)]">
              <ul>
                {n.children.map((c) => (
                  <li class="border-b border-[var(--color-border)] last:border-b-0">
                    <a href={c.href} class="block border-l-4 border-transparent px-5 py-4 transition-colors hover:border-[var(--color-accent)] hover:bg-[var(--color-tint)]" aria-current={isActive(c.href) ? 'page' : undefined}>
                      <span class:list={['block font-black tracking-tight', isActive(c.href) && 'text-[var(--color-accent)]']}>{c.label}</span>
                      {c.d && <span class="mt-0.5 block text-sm text-[var(--color-muted)]">{c.d}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a href={n.href} class:list={['nav-link', isActive(n.href) && 'is-active']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
        )
      )}
    </nav>

    <div class="hidden items-center gap-2 xl:flex">
      <!-- sotto i 1536px il telefono è solo icona (il numero intero è nella barra servizio): spazio alle voci -->
      <a href={site.phone.href} class="flex h-[46px] shrink-0 items-center justify-center gap-2 whitespace-nowrap border-2 border-[var(--color-text)] px-3 text-[0.95rem] font-bold transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]" aria-label={`Chiama ${site.phone.display}`} title={`Chiama ${site.phone.display}`}>
        <svg class="h-4 w-4 min-[1720px]:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
        <span class="hidden min-[1720px]:inline">{site.phone.display}</span>
      </a>
      <a href="/contatti#preventivo" class="btn btn--primary shrink-0 whitespace-nowrap !px-4 !py-3.5">Preventivo gratuito</a>
    </div>

    <button
      id="navToggle"
      class="flex h-11 items-center gap-2.5 border-2 border-[var(--color-text)] px-3 font-[family-name:var(--font-mono)] text-xs font-bold uppercase tracking-[0.15em] xl:hidden"
      aria-label="Apri il menu" aria-expanded="false" aria-controls="mobileNav"
    >
      <span class="relative block h-3 w-5">
        <span class="absolute left-0 top-0 h-0.5 w-5 bg-[var(--color-text)]"></span>
        <span class="absolute left-0 top-[5px] h-0.5 w-5 bg-[var(--color-text)]"></span>
        <span class="absolute left-0 top-[10px] h-0.5 w-5 bg-[var(--color-text)]"></span>
      </span>
      Menu
    </button>
  </div>

</header>

<!-- menu a tutto schermo (telefono e tablet). Fuori dall'header: il backdrop-blur dell'header
     farebbe da riferimento per position:fixed e il pannello non coprirebbe lo schermo -->
<div id="mobileNav" class="mnav fixed inset-0 z-[70] flex flex-col bg-[var(--color-surface)] xl:hidden" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="u-container flex h-[72px] shrink-0 items-center justify-between gap-4 border-b border-[var(--color-border)] md:h-20">
    <a href="/" class="flex items-center" aria-label="Impresa Ippolito, home">
      <Image src={logo} alt="Impresa Ippolito" widths={[200, 300]} sizes="200px" class="h-10 w-auto md:h-12" loading="lazy" />
    </a>
    <button id="navClose" type="button" class="flex h-11 items-center gap-2.5 border-2 border-[var(--color-text)] px-3 font-[family-name:var(--font-mono)] text-xs font-bold uppercase tracking-[0.15em]" aria-label="Chiudi il menu">
      <svg class="h-4 w-4" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="2.2" /></svg>
      Chiudi
    </button>
  </div>

  <div class="flex-1 overflow-y-auto overscroll-contain">
    <nav class="u-container flex flex-col py-2 md:py-8" aria-label="Menu mobile">
      {nav.map((n, i) => (
        <div class="mnav-item border-b border-[var(--color-border)]" style={`--i:${i}`}>
          <a href={n.href} class:list={['group flex items-center justify-between gap-4 py-3 font-[family-name:var(--font-display)] text-[clamp(1.75rem,7.5vw,3.25rem)] font-black uppercase leading-none tracking-tight md:py-4', isActiveItem(n) && 'text-[var(--color-accent)]']} aria-current={isActiveItem(n) ? 'page' : undefined}>
            <span class="flex items-baseline gap-4">
              <span class="font-[family-name:var(--font-mono)] text-xs font-bold text-[var(--color-accent)]">{String(i + 1).padStart(2, '0')}</span>
              {n.label}
            </span>
            <span aria-hidden="true" class="text-2xl text-[var(--color-accent)] transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
          {n.children && (
            <ul class="mb-3 ml-9 border-l-4 border-[var(--color-accent)] pl-4">
              {n.children.filter((c) => c.href !== n.href).map((c) => (
                <li><a href={c.href} class:list={['block py-1.5 text-lg font-black tracking-tight', isActive(c.href) && 'text-[var(--color-accent)]']}>{c.label} <span class="text-[var(--color-accent)]">→</span></a></li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </nav>
  </div>

  <div class="shrink-0 border-t border-[var(--color-border)] bg-[var(--color-tint)]">
    <div class="u-container py-4">
      <p class="flex items-center gap-2 text-sm font-bold">
        <svg class="h-4 w-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        Sopralluogo e preventivo gratuiti
      </p>
      <div class="mt-3 grid grid-cols-2 gap-2.5">
        <a href={site.phone.href} class="btn btn--ghost justify-center !px-3">Chiama</a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn--ghost justify-center !px-3">WhatsApp</a>
        <a href="/contatti#preventivo" class="btn btn--primary col-span-2 justify-center">Preventivo gratuito</a>
      </div>
      <p class="mt-3 flex flex-wrap justify-between gap-x-4 gap-y-1 font-[family-name:var(--font-mono)] text-xs text-[var(--color-muted)]">
        <a href={`mailto:${site.email}`} class="hover:text-[var(--color-accent)]">{site.email}</a>
        <span>{site.hours.label}</span>
      </p>
    </div>
  </div>
</div>

<style>
  /* voci del menu: leggibili e chiaramente cliccabili (area di clic, barra sotto attiva/hover) */
  .nav-link {
    position: relative;
    /* compatte: il contenitore è largo 1200px e deve starci anche il numero di telefono intero */
    padding: 0.6rem 0.58rem;
    font-family: var(--font-display);
    font-size: 0.93rem;
    font-weight: 700;
    letter-spacing: -0.005em;
    white-space: nowrap;
    color: var(--color-text);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.58rem;
    right: 0.58rem;
    bottom: 0.25rem;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .nav-link:hover,
  .nav-drop[data-open] .nav-link { background: var(--color-tint); }
  .nav-link:hover::after,
  .nav-link.is-active::after { transform: scaleX(1); }
  .nav-link.is-active { color: var(--color-accent); }
  .nav-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* menu a tutto schermo: entra dall'alto, le voci arrivano una dopo l'altra */
  .mnav {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-2%);
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s linear 0.4s;
  }
  .mnav[data-open] { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
  .mnav .mnav-item { opacity: 0; transform: translateY(12px); transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .mnav[data-open] .mnav-item { opacity: 1; transform: none; transition-delay: calc(0.08s + var(--i) * 0.05s); }
  @media (prefers-reduced-motion: reduce) {
    .mnav, .mnav .mnav-item { transition: none; transform: none; }
  }

  /* pannello sotto-pagine: scende dalla voce FAQ (hover, tastiera o clic) */
  .nav-drop__panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    clip-path: inset(0 0 100% 0);
    transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), clip-path 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s linear 0.35s;
  }
  .nav-drop:hover .nav-drop__panel,
  .nav-drop:focus-within .nav-drop__panel,
  .nav-drop[data-open] .nav-drop__panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    clip-path: inset(0 -40px -60px -40px);
    transition-delay: 0s;
  }
  .nav-drop__caret { transition: transform 0.25s ease; }
  .nav-drop:hover .nav-drop__caret,
  .nav-drop[data-open] .nav-drop__caret { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) {
    .nav-link, .nav-link::after, .nav-drop__panel, .nav-drop__caret { transition: none; }
  }
</style>

<script>
  // menu a tutto schermo: blocca lo scroll della pagina sotto, Esc e "Chiudi" per uscire
  const btn = document.getElementById('navToggle');
  const close = document.getElementById('navClose');
  const menu = document.getElementById('mobileNav');
  const setMenu = (open: boolean) => {
    if (!menu || !btn) return;
    menu.toggleAttribute('data-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    menu.inert = !open;
    btn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) close?.focus();
    else btn.focus();
  };
  if (menu) { menu.inert = true; menu.setAttribute('aria-hidden', 'true'); }
  btn?.addEventListener('click', () => setMenu(true));
  close?.addEventListener('click', () => setMenu(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu?.hasAttribute('data-open')) setMenu(false); });
  // tornando a desktop il menu si chiude da solo
  window.matchMedia('(min-width: 1280px)').addEventListener('change', (e) => { if (e.matches && menu?.hasAttribute('data-open')) setMenu(false); });

  // pannello FAQ: clic per i dispositivi touch, Esc e clic fuori per chiudere
  document.querySelectorAll<HTMLElement>('[data-drop]').forEach((drop) => {
    const trigger = drop.querySelector('button')!;
    const set = (open: boolean) => {
      drop.toggleAttribute('data-open', open);
      trigger.setAttribute('aria-expanded', String(open));
    };
    trigger.addEventListener('click', () => set(!drop.hasAttribute('data-open')));
    drop.addEventListener('mouseenter', () => trigger.setAttribute('aria-expanded', 'true'));
    drop.addEventListener('mouseleave', () => { if (!drop.hasAttribute('data-open')) trigger.setAttribute('aria-expanded', 'false'); });
    document.addEventListener('click', (e) => { if (!drop.contains(e.target as Node)) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); trigger.blur(); } });
  });
</script>

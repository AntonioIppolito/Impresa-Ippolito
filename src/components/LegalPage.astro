---
// Impaginazione delle pagine legali (privacy, cookie): intestazione + testo in colonna leggibile.
import Base from '../layouts/Base.astro';
interface Props { title: string; heading: string; description: string; path: string; updated: string }
const { title, heading, description, path, updated } = Astro.props;
---
<Base title={title} description={description} breadcrumb={[{ name: heading, path }]}>
  <section class="border-b border-[var(--color-border)]">
    <div class="u-container py-14 md:py-20">
      <p class="u-label">Note legali</p>
      <h1 class="mt-5 text-[clamp(2.25rem,5vw,4rem)] font-black leading-[0.95] tracking-[-0.03em]">{heading}</h1>
      <p class="u-label mt-6">Ultimo aggiornamento: {updated}</p>
    </div>
  </section>
  <section class="u-container py-12 md:py-16">
    <div class="legal max-w-3xl">
      <slot />
    </div>
  </section>
</Base>

<style is:global>
  .legal { font-size: 1.05rem; line-height: 1.7; }
  .legal h2 { margin: 2.4rem 0 0.7rem; font-family: var(--font-display); font-size: 1.45rem; font-weight: 900; letter-spacing: -0.02em; line-height: 1.15; }
  .legal h2:first-child { margin-top: 0; }
  .legal h3 { margin: 1.4rem 0 0.4rem; font-weight: 800; font-size: 1.08rem; }
  .legal p, .legal ul { margin: 0.6rem 0; }
  .legal ul { padding-left: 1.2rem; list-style: square; }
  .legal li { margin: 0.35rem 0; }
  .legal li::marker { color: var(--color-accent); }
  .legal a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .legal .box { margin: 1.2rem 0; border-left: 4px solid var(--color-accent); background: var(--color-tint); padding: 1rem 1.2rem; }
  .legal table { width: 100%; border-collapse: collapse; margin: 0.8rem 0; font-size: 0.97rem; }
  .legal th, .legal td { border-top: 1px solid var(--color-border); padding: 0.6rem 0.8rem 0.6rem 0; text-align: left; vertical-align: top; }
  .legal th { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); font-weight: 700; }
</style>

---
import { Image } from 'astro:assets';
import { services } from '../data/site';
import { getProject } from '../data/projects';

// Griglia bento: 'wide' = 2 colonne su desktop, 'feature' = card fotografica 2 colonne da tablet.
// 'band' = fascia a tutta riga. Con 7 servizi + la fascia le righe si chiudono senza buchi
// (desktop 3 righe da 3 + fascia, tablet 4 righe da 2 + fascia).
const items = services.map((s, i) => {
  let photo = null as null | { src: any; alt: string; pos: string };
  if (s.photo) {
    const p = getProject(s.photo.slug);
    const im = p?.images.find((x) => x.src.src.includes(s.photo!.stem)) ?? p?.images[0];
    if (im) photo = { src: im.src, alt: `${s.t}: ${im.caption || p!.title}`, pos: s.photo.pos ?? '50% 50%' };
  }
  return { ...s, n: String(i + 1).padStart(2, '0'), photo };
});
---
<div class="grid grid-flow-row-dense grid-cols-1 border-l border-t border-[var(--color-border)] sm:grid-cols-2 lg:grid-cols-3">
  {items.map((s) =>
    s.layout === 'feature' && s.photo ? (
      <a
        href={s.href}
        class="card-anim group relative flex min-h-[300px] flex-col justify-end overflow-hidden border-b border-r border-[var(--color-border)] bg-[var(--color-text)] text-white sm:col-span-2 md:min-h-[340px]"
      >
        <Image
          src={s.photo.src}
          alt={s.photo.alt}
          widths={[640, 960, 1400]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 100vw, 60vw"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          style={`object-position: ${s.photo.pos}`}
          loading="lazy"
        />
        <div class="absolute inset-0" style="background: linear-gradient(to top, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.5) 50%, rgb(0 0 0 / 0.05) 100%)" aria-hidden="true"></div>
        <div class="relative p-6 md:p-8">
          <div class="flex items-center gap-3">
            <span class="font-[family-name:var(--font-mono)] text-sm font-bold text-white/80">{s.n}</span>
            <span class="bg-[var(--color-accent)] px-2 py-1 font-[family-name:var(--font-mono)] text-[0.65rem] font-bold uppercase tracking-[0.2em] text-white">In evidenza</span>
          </div>
          <h3 class="mt-3 text-3xl font-black leading-tight tracking-tight md:text-4xl">{s.t}</h3>
          <p class="mt-3 max-w-xl text-base text-white/85">{s.d}</p>
          <span class="mt-5 inline-flex items-center gap-2 font-[family-name:var(--font-mono)] text-xs font-bold uppercase tracking-[0.15em] text-white">
            Guarda i lavori
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1.5">→</span>
          </span>
        </div>
      </a>
    ) : s.layout === 'band' ? (
      <div class="card-anim group relative grid grid-cols-1 gap-6 overflow-hidden border-b border-r border-[var(--color-border)] border-l-4 border-l-[var(--color-accent)] bg-[var(--color-tint)] p-6 sm:col-span-2 md:p-8 lg:col-span-3 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3">
            <span class="u-index text-sm">{s.n}</span>
            <span class="bg-[var(--color-text)] px-2 py-1 font-[family-name:var(--font-mono)] text-[0.65rem] font-bold uppercase tracking-[0.2em] text-white">Il titolare è geometra</span>
          </div>
          <h3 class="mt-4 text-3xl font-black leading-tight tracking-tight transition-colors duration-300 group-hover:text-[var(--color-accent)] md:text-4xl">{s.t}</h3>
          <p class="mt-3 max-w-2xl text-base text-[var(--color-muted)]">{s.d}</p>
        </div>
        {s.tags && (
          <ul class="flex flex-wrap gap-2 lg:col-span-5 lg:justify-end">
            {s.tags.map((t) => (
              <li class="border border-[var(--color-text)] bg-[var(--color-surface)] px-3 py-2 font-[family-name:var(--font-mono)] text-xs font-bold uppercase tracking-wide">{t}</li>
            ))}
          </ul>
        )}
      </div>
    ) : (
      <div
        class:list={[
          'card-anim group relative overflow-hidden border-b border-r border-[var(--color-border)] bg-[var(--color-surface)] p-6 md:p-8',
          s.layout === 'wide' && 'lg:col-span-2',
        ]}
      >
        {s.layout === 'wide' && (
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -right-3 -top-6 font-[family-name:var(--font-display)] text-[8rem] font-black leading-none text-[var(--color-accent)]/10 transition-colors duration-300 group-hover:text-[var(--color-accent)]/20"
          >{s.n}</span>
        )}
        <span class="u-index relative text-sm transition-transform duration-300 group-hover:translate-x-1 inline-block">{s.n}</span>
        <h3 class:list={['relative mt-4 font-black leading-tight tracking-tight transition-colors duration-300 group-hover:text-[var(--color-accent)]', s.layout === 'wide' ? 'text-3xl md:text-4xl' : 'text-2xl']}>{s.t}</h3>
        <p class:list={['relative mt-3 text-base text-[var(--color-muted)]', s.layout === 'wide' && 'max-w-lg']}>{s.d}</p>
        {s.href && (
          <a href={s.href} class="relative mt-5 inline-flex items-center gap-2 font-[family-name:var(--font-mono)] text-xs font-bold uppercase tracking-[0.15em] text-[var(--color-accent)] after:absolute after:inset-0 after:content-['']">
            {s.cta ?? 'Scopri di più'}
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1.5">→</span>
          </a>
        )}
      </div>
    )
  )}
</div>

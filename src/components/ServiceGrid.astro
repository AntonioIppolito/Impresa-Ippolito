---
import { services } from '../data/site';
interface Props { items?: typeof services; }
const { items = services } = Astro.props;
---
<div class="grid grid-cols-1 border-l border-t border-[var(--color-border)] sm:grid-cols-2 lg:grid-cols-3">
  {items.map((s, i) => (
    <div class="group border-b border-r border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-colors duration-300 hover:bg-[var(--color-tint)] md:p-8">
      <span class="u-index text-sm">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="mt-4 text-2xl font-black leading-tight tracking-tight transition-colors group-hover:text-[var(--color-accent)]">{s.t}</h3>
      <p class="mt-3 text-base text-[var(--color-muted)]">{s.d}</p>
    </div>
  ))}
</div>

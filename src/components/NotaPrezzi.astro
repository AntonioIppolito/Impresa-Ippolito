---
// Nota in fondo a ogni sezione con i prezzi (richiesta del titolare): i prezzi sono indicativi.
import { notaIndicativi } from '../data/prezzi';
interface Props { class?: string; tint?: boolean } // tint = sfondo azzurro (sezioni bianche)
const { class: cls = '', tint = false } = Astro.props;
---
<p class:list={['flex items-start gap-3 border-l-4 border-[var(--color-accent)] px-4 py-3 text-sm text-[var(--color-muted)]', tint ? 'bg-[var(--color-tint)]' : 'bg-[var(--color-surface)]', cls]}>
  <svg class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.5" /></svg>
  <span>{notaIndicativi}</span>
</p>

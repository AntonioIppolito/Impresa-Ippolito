---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
interface Props { project: Project; eager?: boolean; }
const { project, eager = false } = Astro.props;
---
<a
  href={`/lavori-eseguiti/${project.slug}`}
  class="group block border border-[var(--color-border)] bg-[var(--color-surface)]"
  data-category={project.category}
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <Image
      src={project.cover}
      alt={`${project.title} — ristrutturazione Impresa Ippolito`}
      widths={[400, 640, 900]}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      class="h-full w-full object-cover transition-transform duration-300 ease-linear group-hover:scale-[1.04]"
      loading={eager ? 'eager' : 'lazy'}
    />
    <span class="u-label absolute left-0 top-0 bg-[var(--color-accent)] px-3 py-2 text-white">{project.category}</span>
  </div>
  <div class="flex items-baseline justify-between gap-3 p-5">
    <div>
      <h3 class="text-xl font-black leading-tight tracking-tight transition-colors group-hover:text-[var(--color-accent)]">{project.title}</h3>
      {project.location && <p class="u-label mt-1">{project.location}</p>}
    </div>
    <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-muted)]">{project.images.length} foto</span>
  </div>
</a>

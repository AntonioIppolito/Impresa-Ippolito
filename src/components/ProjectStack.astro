---
// Mazzo interattivo di progetti (adattamento di "InteractiveCardStack" senza React/Framer):
// trascina la card in cima per mandarla in fondo, autoplay con pausa su hover,
// click sulla card = apre il progetto. Stile del sito: spigoli vivi, bordi 1px, niente ombre morbide.
import { Image } from 'astro:assets';
import { pickPhoto } from '../data/projects';

// progetti con le foto più belle (diverse da quelle già nella hero)
const picks = [
  { slug: 'ristrutturazione-appartamento-milano-24', stem: '_D5A4790', pos: '50% 50%' },
  { slug: 'cartongesso-design', stem: 'cartongesso-design-03', pos: '50% 26%' },
  { slug: 'appartamento-senago', stem: 'IMG20220330183500', pos: '50% 58%' },
  { slug: 'appartamento-lambrate', stem: 'IMG-20191108-WA00144706', pos: '50% 55%' },
  { slug: 'appartamento-viale-jenner', stem: '2017-12-16-PHOTO-00004359-1', pos: '50% 62%' },
  { slug: 'ristrutturazione-bresso', stem: 'IMG_20180209_143151', pos: '50% 50%' },
  { slug: 'villa-bollate', stem: 'P110329_153814', pos: '50% 55%' },
  { slug: 'bagno-monza-4', pos: '50% 45%' },
];

const items = picks.map((p) => {
  const { project, image } = pickPhoto(p.slug, p.stem);
  return {
    href: `/lavori-eseguiti/${project.slug}`,
    title: project.title,
    location: project.location,
    category: project.category,
    count: project.images.length,
    src: image.src,
    alt: `${project.title}${image.caption ? `: ${image.caption}` : ''}, lavoro dell'Impresa Ippolito`,
    pos: p.pos,
  };
});
const total = String(items.length).padStart(2, '0');
---
<div data-stack class="select-none" role="region" aria-roledescription="mazzo di progetti" aria-label="Progetti in evidenza">
  <div class="relative pt-10">
    <div data-stage class="relative aspect-[4/5] w-full [perspective:1000px] sm:aspect-[16/11]">
      {items.map((it, i) => (
        <a
          href={it.href}
          data-card
          data-title={it.title}
          draggable="false"
          tabindex={i === 0 ? 0 : -1}
          aria-hidden={i === 0 ? 'false' : 'true'}
          class="group absolute inset-0 flex cursor-grab flex-col overflow-hidden border border-[var(--color-border)] bg-[var(--color-surface)] will-change-transform [touch-action:pan-y] active:cursor-grabbing"
          style={`z-index:${items.length - i}`}
        >
          <div class="relative min-h-0 flex-1 overflow-hidden bg-[var(--color-text)]">
            <Image
              src={it.src}
              alt={it.alt}
              widths={[480, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 60vw"
              draggable="false"
              class="pointer-events-none absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              style={`object-position:${it.pos}`}
              loading={i < 2 ? 'eager' : 'lazy'}
            />
            <span class="u-label absolute left-0 top-0 bg-[var(--color-accent)] px-3 py-2 text-white">{it.category}</span>
          </div>
          <div class="flex items-center justify-between gap-4 border-t border-[var(--color-border)] px-5 py-4">
            <div class="min-w-0">
              <p class="truncate text-xl font-black leading-tight tracking-tight transition-colors group-hover:text-[var(--color-accent)]">{it.title}</p>
              {it.location && <p class="u-label mt-1">{it.location}</p>}
            </div>
            <div class="flex shrink-0 items-center gap-3">
              <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-muted)]">{it.count} foto</span>
              <span aria-hidden="true" class="font-[family-name:var(--font-display)] text-2xl font-black text-[var(--color-accent)] transition-transform duration-300 group-hover:translate-x-1">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- controlli -->
  <div class="mt-6 flex items-center justify-between gap-4 border-t border-[var(--color-border)] pt-4">
    <p class="flex min-w-0 items-baseline gap-3" aria-live="polite">
      <span class="shrink-0 font-[family-name:var(--font-mono)] text-sm font-bold">
        <span data-count class="text-[var(--color-accent)]">01</span><span class="text-[var(--color-muted)]"> / {total}</span>
      </span>
      <span data-current class="truncate font-black tracking-tight">{items[0].title}</span>
    </p>
    <div class="flex shrink-0 items-center gap-2">
      <span class="u-label mr-2 hidden lg:inline">Trascina o usa le frecce</span>
      <button type="button" data-prev aria-label="Progetto precedente" class="flex h-11 w-11 items-center justify-center border border-[var(--color-text)] font-black transition-colors hover:bg-[var(--color-text)] hover:text-white">←</button>
      <button type="button" data-next aria-label="Progetto successivo" class="flex h-11 w-11 items-center justify-center border border-[var(--color-accent)] bg-[var(--color-accent)] font-black text-white transition-colors hover:border-[var(--color-text)] hover:bg-[var(--color-text)]">→</button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-stack]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLAnchorElement>('[data-card]')];
    const n = cards.length;
    if (n < 2) return;
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const currentEl = root.querySelector<HTMLElement>('[data-current]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const SPRING = 'transform .6s cubic-bezier(.34,1.45,.64,1), opacity .45s ease';
    const VISIBLE = 4;            // card visibili dietro quella in cima
    const AUTOPLAY_MS = 3500;
    const rand = () => Math.random() * 4 - 2;
    const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));

    // order[0] = in fondo … order[n-1] = in cima (all'avvio la prima card è in cima)
    let order = cards.slice().reverse();
    const rot = new Map(cards.map((c) => [c, rand()]));

    const layout = (animate = true) => {
      order.forEach((c, idx) => {
        const depth = n - 1 - idx;
        const top = depth === 0;
        c.style.transition = animate && !reduce ? SPRING : 'none';
        c.style.zIndex = String(idx + 1);
        c.style.transform = `translate3d(0, ${-depth * 12}px, 0) scale(${1 - depth * 0.045}) rotate(${top ? 0 : depth * -1.5 + rot.get(c)!}deg)`;
        c.style.opacity = depth >= VISIBLE ? '0' : String(1 - depth * 0.14);
        c.style.pointerEvents = top ? 'auto' : 'none';
        c.tabIndex = top ? 0 : -1;
        c.setAttribute('aria-hidden', String(!top));
      });
      const top = order[n - 1];
      if (countEl) countEl.textContent = String(cards.indexOf(top) + 1).padStart(2, '0');
      if (currentEl) currentEl.textContent = top.dataset.title || '';
    };

    const next = () => { const top = order.pop()!; rot.set(top, rand()); order.unshift(top); layout(); };
    const prev = () => { const bottom = order.shift()!; order.push(bottom); layout(); };

    // ---- autoplay (pausa su hover/focus, fuori viewport, tab nascosta) ----
    let timer: number | undefined;
    let hovering = false, inView = false, dragging = false;
    const nextReady = () => {
      const img = order[n - 2]?.querySelector('img');
      return !img || (img.complete && img.naturalWidth > 0);
    };
    const stop = () => { if (timer !== undefined) window.clearInterval(timer); timer = undefined; };
    const start = () => {
      if (reduce || timer !== undefined || hovering || !inView || dragging || document.hidden) return;
      timer = window.setInterval(() => { if (nextReady()) next(); }, AUTOPLAY_MS);
    };
    const restart = () => { stop(); start(); };

    new IntersectionObserver((entries) => {
      inView = entries.some((e) => e.isIntersecting);
      inView ? start() : stop();
    }, { threshold: 0.35 }).observe(root);

    // precarica tutte le foto del mazzo quando la sezione si avvicina (niente card vuote sfogliando)
    new IntersectionObserver((entries, obs) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      root.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
      obs.disconnect();
    }, { rootMargin: '800px 0px' }).observe(root);
    root.addEventListener('mouseenter', () => { hovering = true; stop(); });
    root.addEventListener('mouseleave', () => { hovering = false; start(); });
    root.addEventListener('focusin', () => { hovering = true; stop(); });
    root.addEventListener('focusout', () => { hovering = false; start(); });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    root.querySelector('[data-next]')?.addEventListener('click', () => { next(); restart(); });
    root.querySelector('[data-prev]')?.addEventListener('click', () => { prev(); restart(); });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); next(); order[n - 1].focus(); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); order[n - 1].focus(); }
    });

    // ---- trascina per mandare in fondo (inclinazione 3D + ritorno a molla) ----
    let sx = 0, sy = 0, dx = 0, dy = 0, moved = false;
    const sensitivity = () => Math.min(140, root.clientWidth * 0.22);

    cards.forEach((card) => {
      card.addEventListener('dragstart', (e) => e.preventDefault());
      card.addEventListener('pointerdown', (e) => {
        if (card !== order[n - 1] || e.button !== 0) return;
        dragging = true; moved = false;
        sx = e.clientX; sy = e.clientY; dx = dy = 0;
        card.setPointerCapture(e.pointerId);
        card.style.transition = 'none';
        stop();
      });
      card.addEventListener('pointermove', (e) => {
        if (!dragging || card !== order[n - 1]) return;
        dx = e.clientX - sx; dy = e.clientY - sy;
        if (Math.hypot(dx, dy) > 6) moved = true;
        const ex = dx * 0.6, ey = dy * 0.6;
        card.style.transform = `translate3d(${ex}px, ${ey}px, 0) rotateX(${clamp(-ey * 0.3, -18, 18)}deg) rotateY(${clamp(ex * 0.3, -18, 18)}deg)`;
      });
      const end = (cancelled: boolean) => {
        if (!dragging) return;
        dragging = false;
        if (!cancelled && (Math.abs(dx) > sensitivity() || Math.abs(dy) > sensitivity())) next();
        else layout();
        start();
      };
      card.addEventListener('pointerup', () => end(false));
      card.addEventListener('pointercancel', () => end(true));
      // un trascinamento non deve aprire il progetto
      card.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } });
    });

    layout(false);
  });
</script>

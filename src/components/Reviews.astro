---
// Recensioni reali (src/data/recensioni.ts). `full` = pagina /recensioni: testi interi, senza "leggi tutto".
import { google, conTesto, soloVoto, aggiornatoRecensioni, ratingLabel, tutteCinque } from '../data/recensioni';
interface Props { full?: boolean }
const { full = false } = Astro.props;

// bento senza buchi con qualsiasi numero di recensioni (griglia da 6 colonne su desktop, 2 su tablet):
// le prime due occupano mezza riga, poi righe da tre; se avanzano 2 card vanno a mezza riga, se ne avanza 1
// le ultime quattro diventano due righe da due (così una recensione breve non resta da sola su tutta la riga)
const span = (i: number, n: number) => {
  const md = n % 2 === 1 && i === n - 1 ? 'md:col-span-2' : '';
  if (n === 1) return 'md:col-span-2 lg:col-span-6';
  if (i < 2) return `lg:col-span-3 ${md}`;
  const rest = n - 2;
  const tail = rest % 3;
  if (rest === 1) return `lg:col-span-6 ${md}`;
  const halves = tail === 2 ? 2 : tail === 1 ? 4 : 0; // card finali a mezza riga
  const lg = i >= n - halves ? 'lg:col-span-3' : 'lg:col-span-2';
  return `${lg} ${md}`;
};
const long = (t?: string) => (t?.length ?? 0) > 320;
const stars = [1, 2, 3, 4, 5];
---
<div>
  <!-- riepilogo -->
  <div class="grid grid-cols-1 gap-6 border border-[var(--color-border)] bg-[var(--color-surface)] p-6 md:grid-cols-12 md:items-center md:p-8">
    <div class="flex items-center gap-5 md:col-span-6">
      <p class="font-[family-name:var(--font-display)] text-[clamp(3.5rem,8vw,5.5rem)] font-black leading-none tracking-tight">{ratingLabel}</p>
      <div>
        <div class="flex gap-1 text-[#F5B301]" aria-label={`${ratingLabel} stelle su 5`}>
          {stars.map((s) => <svg class:list={['h-6 w-6', s > Math.round(google.rating) && 'text-[var(--color-border)]']} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" /></svg>)}
        </div>
        <p class="mt-2 text-lg font-bold">{google.count} recensioni su Google{tutteCinque ? ', tutte a 5 stelle' : ''}</p>
        <p class="u-label mt-1">Impresa edile Ippolito Antonio · aggiornate al {aggiornatoRecensioni}</p>
      </div>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row md:col-span-6 md:flex-col md:items-end lg:flex-row lg:justify-end">
      <a href={google.url} target="_blank" rel="noopener" class="btn btn--ghost justify-center whitespace-nowrap">Leggi su Google</a>
      <a href={google.url} target="_blank" rel="noopener" class="btn btn--primary justify-center whitespace-nowrap">Lascia una recensione</a>
    </div>
  </div>

  <!-- recensioni con testo -->
  <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-6">
    {conTesto.map((r, i) => (
      <figure class:list={['card-anim group flex flex-col border border-[var(--color-border)] bg-[var(--color-surface)] p-6 md:p-8', span(i, conTesto.length)]}>
        <div class="flex items-center justify-between gap-4">
          <div class="flex gap-0.5 text-[#F5B301]" aria-label={`${r.voto} stelle su 5`}>
            {stars.map((s) => <svg class:list={['h-4 w-4', s > r.voto && 'text-[var(--color-border)]']} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" /></svg>)}
          </div>
          <span aria-hidden="true" class="font-[family-name:var(--font-display)] text-5xl font-black leading-none text-[var(--color-accent)]/25 transition-colors duration-300 group-hover:text-[var(--color-accent)]">“</span>
        </div>
        <blockquote class="mt-3 flex-1">
          <p class:list={['rv-text whitespace-pre-line text-[1.02rem] leading-relaxed', !full && long(r.testo) && 'rv-clamp']} data-rv-text>{r.testo}</p>
          {!full && long(r.testo) && (
            <button type="button" class="u-label mt-3 text-[var(--color-accent)] hover:underline" data-rv-more aria-expanded="false">Leggi tutta la recensione</button>
          )}
        </blockquote>
        <figcaption class="mt-5 flex items-baseline justify-between gap-3 border-t border-[var(--color-border)] pt-4">
          <span class="font-black tracking-tight">{r.autore}{r.ruolo && <span class="font-normal text-[var(--color-muted)]">, {r.ruolo.toLowerCase()}</span>}</span>
          <span class="u-label whitespace-nowrap">{r.fonte} · {r.anno}</span>
        </figcaption>
      </figure>
    ))}
  </div>

  <!-- solo voto -->
  <div class="mt-4 flex flex-col gap-4 border border-[var(--color-border)] bg-[var(--color-surface)] p-5 md:flex-row md:items-center md:gap-8 md:px-8">
    <p class="u-label shrink-0">{soloVoto.every((r) => r.voto === 5) ? 'Hanno dato il massimo dei voti anche' : 'Hanno lasciato il loro voto anche'}</p>
    <ul class="flex flex-wrap gap-2">
      {soloVoto.map((r) => (
        <li class="flex items-center gap-2 border border-[var(--color-border)] px-3 py-2 text-sm">
          <span class="font-bold">{r.autore}</span>
          <span class="text-[#F5B301]" aria-label={`${r.voto} stelle su 5`}>{'★'.repeat(r.voto)}<span class="text-[var(--color-border)]">{'★'.repeat(5 - r.voto)}</span></span>
          <span class="text-[var(--color-muted)]">{r.fonte === 'Facebook' ? 'consiglia su Facebook' : `${r.fonte} · ${r.anno}`}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style is:global>
  .rv-clamp:not([data-open]) {
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-rv-more]').forEach((btn) => {
    const text = btn.parentElement?.querySelector<HTMLElement>('[data-rv-text]');
    btn.addEventListener('click', () => {
      const open = !text?.hasAttribute('data-open');
      text?.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Mostra meno' : 'Leggi tutta la recensione';
    });
  });
</script>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/antonio-ippolito.jpg';
import { site } from '../data/site';
import { answered } from '../data/faq';
const { address: a } = site;
const faqPreview = answered.filter((f) => f.home);
const bbox = `${a.geo.lng - 0.006},${a.geo.lat - 0.003},${a.geo.lng + 0.006},${a.geo.lat + 0.003}`;
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${a.geo.lat},${a.geo.lng}`;
---
<Base
  title="Contatti e preventivo gratuito | Impresa Ippolito"
  description="Preventivo gratuito per la vostra ristrutturazione: chiamate o scrivete su WhatsApp al 339 533 0704. Sede in Via Monte Bianco 25 a Novate Milanese (MI)."
  breadcrumb={[{ name: 'Contatti', path: '/contatti' }]}
>
  <section class="border-b border-[var(--color-border)]">
    <div class="u-container py-16 md:py-24">
      <p class="u-label">Contatti</p>
      <h1 class="mt-5 max-w-4xl text-[clamp(2.5rem,7vw,5.5rem)] font-black leading-[0.9] tracking-[-0.03em]">
        Parliamo del <span class="text-[var(--color-accent)]">vostro lavoro.</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg text-[var(--color-muted)]">
        Chiamateci, scriveteci su WhatsApp o compilate il modulo: fissiamo un sopralluogo e prepariamo un preventivo dettagliato. Risponde direttamente il geom. Antonio Ippolito.
      </p>
    </div>
  </section>

  <section class="u-container grid grid-cols-1 gap-0 md:grid-cols-12">
    <!-- colonna recapiti -->
    <div class="border-b border-[var(--color-border)] py-12 md:col-span-5 md:border-b-0 md:border-r md:py-16 md:pr-10">
      <figure class="mb-10 flex items-center gap-5">
        <Image src={portrait} alt="Il geometra Antonio Ippolito, titolare dell'Impresa Ippolito" width={96} height={104} densities={[1, 2]} class="h-[104px] w-[96px] shrink-0 border border-[var(--color-border)] object-cover" />
        <figcaption>
          <span class="block text-lg font-black tracking-tight">Geom. Antonio Ippolito</span>
          <span class="u-label mt-1 block">Titolare · vi risponde lui</span>
        </figcaption>
      </figure>
      <p class="u-label">Recapiti diretti</p>
      <div class="mt-6 flex flex-col gap-3">
        <a href={site.phone.href} class="btn btn--primary justify-between">Telefono <span>{site.phone.display}</span></a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn--ghost justify-between">WhatsApp <span>{site.phone.display}</span></a>
        <a href={site.facebook} target="_blank" rel="noopener" class="btn btn--ghost justify-between">Facebook <span>@impresaippolito</span></a>
      </div>

      <p class="u-label mt-10">Sede</p>
      <address class="mt-4 not-italic text-lg">
        {a.street}<br />{a.zip} {a.city} ({a.province})
      </address>
      <a href={a.maps} target="_blank" rel="noopener" class="u-label mt-3 inline-block hover:text-[var(--color-accent)]">Apri in mappe →</a>

      <p class="u-label mt-10">Dati</p>
      <p class="mt-3 font-[family-name:var(--font-mono)] text-sm text-[var(--color-muted)]">
        {site.legalName}<br />
        Albo Artigiani {site.legal.alboArtigiani}<br />
        P.I. {site.legal.piva}<br />
        {site.legal.regImprese}
      </p>
    </div>

    <!-- colonna form -->
    <div id="preventivo" class="scroll-mt-24 py-12 md:col-span-7 md:py-16 md:pl-10">
      <p class="u-label">Richiedi un preventivo</p>
      <form
        name="preventivo"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2"
      >
        <input type="hidden" name="form-name" value="preventivo" />
        <p class="hidden"><label>Non compilare: <input name="bot-field" /></label></p>

        <div class="sm:col-span-1">
          <label for="nome" class="u-label">Nome e cognome *</label>
          <input id="nome" name="nome" type="text" required class="mt-2 w-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-base focus:border-[var(--color-accent)]" />
        </div>
        <div class="sm:col-span-1">
          <label for="tel" class="u-label">Telefono *</label>
          <input id="tel" name="telefono" type="tel" required class="mt-2 w-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-base focus:border-[var(--color-accent)]" />
        </div>
        <div class="sm:col-span-1">
          <label for="email" class="u-label">Email</label>
          <input id="email" name="email" type="email" class="mt-2 w-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-base focus:border-[var(--color-accent)]" />
        </div>
        <div class="sm:col-span-1">
          <label for="tipo" class="u-label">Tipo di intervento</label>
          <select id="tipo" name="tipo" class="mt-2 w-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-base focus:border-[var(--color-accent)]">
            <option>Ristrutturazione completa</option>
            <option>Bagno</option>
            <option>Cucina</option>
            <option>Impianti</option>
            <option>Pavimenti e rivestimenti</option>
            <option>Cartongesso</option>
            <option>Altro</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="msg" class="u-label">Descrivi il lavoro *</label>
          <textarea id="msg" name="messaggio" rows="5" required class="mt-2 w-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-base focus:border-[var(--color-accent)]"></textarea>
        </div>
        <div class="flex items-start gap-3 sm:col-span-2">
          <input id="privacy" name="privacy" type="checkbox" required class="mt-1 h-5 w-5 shrink-0 accent-[var(--color-accent)]" />
          <label for="privacy" class="text-sm text-[var(--color-muted)]">Ho letto l’informativa privacy e acconsento al trattamento dei dati per essere ricontattato. *</label>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="btn btn--primary w-full justify-center sm:w-auto">Invia richiesta</button>
        </div>
      </form>
    </div>
  </section>

  <!-- domande prima di scriverci -->
  <section class="border-t border-[var(--color-border)] bg-[var(--color-tint)] py-14 md:py-20">
    <div class="u-container grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="u-label">Prima di scriverci</p>
        <h2 class="mt-4 text-[clamp(1.75rem,3.5vw,3rem)] font-black leading-none tracking-tight">Le domande più frequenti</h2>
        <a href="/domande-frequenti" class="btn btn--ghost mt-7">Tutte le domande</a>
      </div>
      <div class="border-t border-[var(--color-border)] md:col-span-8">
        {faqPreview.map((f) => (
          <div class="border-b border-[var(--color-border)] py-5">
            <h3 class="text-lg font-black tracking-tight">{f.q}</h3>
            <p class="mt-2 text-[var(--color-muted)]">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- mappa -->
  <section class="border-t border-[var(--color-border)]">
    <iframe
      title="Mappa: sede Impresa Ippolito, Via Monte Bianco 25, Novate Milanese"
      src={osm}
      loading="lazy"
      class="block h-[360px] w-full border-0 grayscale md:h-[440px]"
    ></iframe>
  </section>
</Base>

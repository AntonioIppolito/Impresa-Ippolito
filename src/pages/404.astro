---
import Base from '../layouts/Base.astro';
import { nav } from '../data/site';
---
<Base title="Pagina non trovata | Impresa Ippolito" description="La pagina che cerchi non esiste. Torna alla home o vai ai servizi e ai lavori eseguiti.">
  <section class="u-container flex min-h-[60vh] flex-col justify-center py-20">
    <p class="u-index text-lg">404</p>
    <h1 class="mt-4 text-[clamp(2.5rem,8vw,6rem)] font-black leading-[0.9] tracking-[-0.03em]">Pagina non trovata.</h1>
    <p class="mt-6 max-w-xl text-lg text-[var(--color-muted)]">La pagina che cercavi è stata spostata o non esiste più. Ecco dove puoi andare:</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn--primary">Home</a>
      {nav.map((n) => <a href={n.href} class="btn btn--ghost">{n.label}</a>)}
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Section from '../components/Section.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import ProjectStack from '../components/ProjectStack.astro';
import WhyUs from '../components/WhyUs.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import CTA from '../components/CTA.astro';
import Reviews from '../components/Reviews.astro';
import { beforeAfter } from '../data/beforeafter';
import { compliance, site, ORG_ID, WEBSITE_ID, SITE_URL } from '../data/site';

// WebSite: Google lo usa per il nome del sito nei risultati; collega sito ed entità impresa
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: site.name,
  alternateName: [site.officialName, 'Impresa Edile Ippolito'],
  url: `${SITE_URL}/`,
  inLanguage: 'it-IT',
  publisher: { '@id': ORG_ID },
};
---
<Base
  title="Ristrutturazioni Novate Milanese e Milano | Impresa Ippolito"
  description="Impresa edile a Novate Milanese: ristrutturazioni chiavi in mano a Milano e Monza Brianza, con il titolare geometra in cantiere. Preventivo gratuito."
  schema={[websiteSchema]}
>
  <Hero />
  <TrustBar />

  <!-- Chi siamo -->
  <Section label="Chi siamo" title="Oltre 25 anni di attività, un solo referente." center>
    <div slot="aside" class="divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
      <div class="flex items-baseline justify-between py-3"><span class="u-label">Attività</span><span class="font-[family-name:var(--font-display)] text-xl font-black">25+ anni</span></div>
      <div class="flex items-baseline justify-between py-3"><span class="u-label">Esperienza</span><span class="font-[family-name:var(--font-display)] text-xl font-black">30+ anni</span></div>
      <div class="flex items-baseline justify-between py-3"><span class="u-label">Zona</span><span class="font-[family-name:var(--font-display)] text-xl font-black">Milano · MB</span></div>
      <div class="flex items-baseline justify-between py-3"><span class="u-label">Titolare</span><span class="font-[family-name:var(--font-display)] text-xl font-black">Geom. Ippolito</span></div>
      <div class="flex items-baseline justify-between py-3"><span class="u-label">In cantiere</span><span class="font-[family-name:var(--font-display)] text-xl font-black">Di persona</span></div>
    </div>
    <p class="text-[clamp(1.5rem,2.6vw,2.1rem)] font-black leading-[1.08] tracking-tight">
      L’Impresa Ippolito opera nelle ristrutturazioni edili in tutta la provincia di Milano e Monza Brianza, sul principio di qualità, professionalità e garanzia dei lavori.
    </p>
    <p class="mt-6 text-lg text-[var(--color-muted)]">
      L’esecuzione delle opere è seguita in tutte le fasi direttamente dal titolare, il geometra Antonio Ippolito, che grazie a un’equipe di artigiani e professionisti di fiducia altamente qualificati offre un servizio completo a 360 gradi. Il titolare è presente di persona in cantiere e segue l’avanzamento dei lavori sul posto.
    </p>
  </Section>

  <!-- Servizi -->
  <Section label="Servizi" id="servizi" tone="tint" title="Cosa facciamo" lead="Ristrutturazioni parziali, complete e chiavi in mano di appartamenti, case, uffici e negozi. Qualsiasi intervento, interno ed esterno.">
    <a slot="aside" href="/servizi" class="btn btn--ghost">Tutti i servizi</a>
    <ServiceGrid />
  </Section>

  <!-- Lavori showcase -->
  <Section label="Lavori" title="Lavori eseguiti" lead="Foto reali dei nostri cantieri e delle case consegnate a Milano e in Monza Brianza.">
    <a slot="aside" href="/lavori-eseguiti" class="btn btn--primary">Vedi tutti i lavori</a>
    <ProjectStack />
  </Section>

  <!-- Before/After campione -->
  <Section label="Prima e dopo" tone="tint" title="Lo stesso spazio, trasformato." lead="Trascina il cursore su ogni immagine per confrontare com’era prima e com’è diventato dopo il nostro intervento.">
    <a slot="aside" href="/prima-e-dopo" class="btn btn--ghost">Altri confronti</a>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      {beforeAfter.slice(0, 2).map((ba) => (
        <BeforeAfter before={ba.before} after={ba.after} label={ba.label} />
      ))}
    </div>
  </Section>

  <!-- Recensioni reali (Google e Facebook) -->
  <section id="recensioni" class="border-t border-[var(--color-border)] py-14 md:py-20">
    <div class="u-container">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="u-label">Recensioni</p>
          <h2 class="mt-4 text-[clamp(2rem,3.5vw,3.25rem)] font-black leading-[0.95] tracking-tight">Cosa dicono i nostri clienti</h2>
        </div>
        <a href="/recensioni" class="u-label hover:text-[var(--color-accent)]">Tutte le recensioni →</a>
      </div>
      <Reviews />
    </div>
  </section>

  <!-- Perché sceglierci -->
  <Section label="Perché sceglierci" tone="dark" title="Noi garantiamo" lead="Dieci impegni concreti, dal preventivo alla consegna.">
    <div slot="aside" class="card-anim card-anim--dark group border border-white/15 bg-[var(--color-text)] p-5">
      {compliance.map((c, i) => (
        <p class:list={['text-sm text-white/70 transition-colors duration-300 group-hover:text-white', i > 0 && 'mt-3']}><span class="mr-2 font-[family-name:var(--font-mono)] font-bold text-[var(--color-accent)] transition-colors duration-300 group-hover:text-white">✓</span>{c}</p>
      ))}
    </div>
    <WhyUs />
  </Section>

  <CTA />
</Base>
